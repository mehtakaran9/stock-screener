[run]
source = backend
omit =
    backend/test_*.py
    backend/backtest_may2026.py
    backend/reverse_backtest.py
    backend/bigmove_research.py
    backend/conviction_research.py
    backend/alt_data.py
    */venv/*

[report]
fail_under = 95
show_missing = true
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
